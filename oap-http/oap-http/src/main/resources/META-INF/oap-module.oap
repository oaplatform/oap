name = oap-http
services {
  nio-compression-handler {
    implementation = oap.http.server.nio.handlers.CompressionNioHandler
  }

  blocking-read-timeout-handler {
    implementation = oap.http.server.nio.handlers.BlockingReadTimeoutHandler
    parameters {
      readTimeout = 60s
    }
  }

  keepalive-requests-handler {
    implementation = oap.http.server.nio.handlers.KeepaliveRequestsHandler
    parameters {
      keepaliveRequests = 1000
    }
  }

  oap-http-server {
    implementation = oap.http.server.nio.NioHttpServer
    parameters {
      defaultPort {
        httpPort = 8080
//        httpsPort = 8443
//        keyStore = /path
//        password = ...
      }
      additionalHttpPorts {
        httpprivate = 8081
      }
      autoRefreshCertificates = 12h // -1 - disable

      backlog = -1
      idleTimeout = -1
      tcpNodelay = true
      ioThreads = 0 // relative to cores: 0 = max(2, cores), N, -N = cores - N, 1.5 = cores * 1.5, -1.5 = cores / 1.5
      sslHandshakeOffload = true // https only: true = run TLS handshake tasks in a separate pool instead of io threads; false = inline on io threads
      sslHandshakeThreads = 0.25 // pool size when offload = true, relative to cores: 0 = max(2, cores), N, -N = cores - N, 1.5 = cores * 1.5, -1.5 = cores / 1.5
      sslHandshakeMinThreads = 2 // lower bound of the pool size
      sslHandshakeQueue = 1024 // pending handshake tasks when offload = true; overflow closes the new connection
      workerThreads = -1
      maxEntitySize = -1
      maxParameters = -1
      maxHeaders = -1
      maxHeaderSize = -1
      statistics = false

      alwaysSetDate = true
      alwaysSetKeepAlive = true

      handlers = [
        <modules.this.keepalive-requests-handler>
        <modules.this.nio-compression-handler>
        <modules.this.blocking-read-timeout-handler>
      ]
    }
    supervision.supervise = true
  }

  oap-http-health-handler {
    implementation = oap.http.server.nio.health.HealthHttpHandler
    parameters {
      server = <modules.this.oap-http-server>
      prefix = /healtz
      port = httpprivate
      providers = []
    }

    supervision.supervise = true
  }

  oap-http-zero-png-handler {
    enabled = false
    implementation = oap.http.server.nio.ZeroPngHttpHandler
    parameters {
      server = <modules.this.oap-http-server>
      prefix = /static/pixel.png
    }
  }
}

configurations:
  - loader: oap.json.TypeIdFactory
    config:
      cookie: io.undertow.server.handlers.CookieImpl
