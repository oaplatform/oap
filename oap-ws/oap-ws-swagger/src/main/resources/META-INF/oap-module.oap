name: oap-ws-swagger

dependsOn:
  - oap-ws
  - oap-template

services:
  swagger-ui:
    implementation: oap.ws.swagger.SwaggerWS
    parameters:
      templateEngine = <modules.oap-template.oap-template-engine>
      version: "5.33.2"
      urls: []
      loginMethod: POST
      urlTemplate: ""
    ws-service.path: swagger
