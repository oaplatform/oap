<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="SwaggerUI" />
  <title>SwaggerUI</title>
  <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@{{ version }}/swagger-ui.css" />
</head>
<body>
<div id="swagger-ui"></div>

<script src="https://unpkg.com/swagger-ui-dist@{{ version }}/swagger-ui-bundle.js" crossorigin></script>
<script src="https://unpkg.com/swagger-ui-dist@{{ version }}/swagger-ui-standalone-preset.js" crossorigin></script>

<script>
  function renderSwaggerUi() {
    window.ui = SwaggerUIBundle({
      presets: [
          SwaggerUIBundle.presets.apis,
          SwaggerUIStandalonePreset
      ],
      plugins: [
        SwaggerUIBundle.plugins.DownloadUrl
      ],
      urls: [
{{% range $u := urls }}        {name: "{{ $u.name }}", url: "{{ $u.url }}"},
{{% end }}      ],
      dom_id: '#swagger-ui',
      deepLinking: true,
      layout: "StandaloneLayout"
    });
  }

{{% if urlTemplate }}
  var urlTemplate = {{ urlTemplateJs }};
  var requestTemplate = {{ requestTemplateJs }};
  var loginMethod = {{ loginMethodJs }};

  function substituteUrl( template, username, password ) {
    return template.split( "{username}" ).join( encodeURIComponent( username ) )
                    .split( "{password}" ).join( encodeURIComponent( password ) );
  }

  function jsonEscape( value ) {
    return value.split( "\\" ).join( "\\\\" ).split( "\"" ).join( "\\\"" );
  }

  function substituteBody( template, username, password ) {
    return template.split( "{username}" ).join( jsonEscape( username ) )
                    .split( "{password}" ).join( jsonEscape( password ) );
  }

  function doLogin() {
    var username = document.getElementById( "login-username" ).value;
    var password = document.getElementById( "login-password" ).value;
    var url = substituteUrl( urlTemplate, username, password );
    var options = { method: loginMethod };
    if ( loginMethod === "POST" ) {
      options.headers = { "Content-Type": "application/json" };
      options.body = substituteBody( requestTemplate, username, password );
    }
    fetch( url, options ).then( function( response ) {
      if ( response.ok ) {
        document.getElementById( "login-box" ).style.display = "none";
      } else {
        var err = document.getElementById( "login-error" );
        err.textContent = "Login failed (" + response.status + ")";
        err.style.display = "";
      }
    } );
  }

  function createLoginUI() {
    var box = document.createElement( "div" );
    box.id = "login-box";
    box.style.position = "absolute";
    box.style.top = "0";
    box.style.left = "0";
    box.style.right = "0";
    box.style.zIndex = "1000";
    box.style.background = "#fff";
    box.style.padding = "10px";
    box.style.borderBottom = "1px solid #ccc";

    var userInput = document.createElement( "input" );
    userInput.id = "login-username";
    userInput.type = "text";
    var userLabel = document.createElement( "label" );
    userLabel.textContent = "User";
    userLabel.appendChild( userInput );

    var passwordInput = document.createElement( "input" );
    passwordInput.id = "login-password";
    passwordInput.type = "password";
    var passwordLabel = document.createElement( "label" );
    passwordLabel.textContent = "Password";
    passwordLabel.appendChild( passwordInput );

    var button = document.createElement( "button" );
    button.id = "login-button";
    button.type = "button";
    button.textContent = "Login";

    var error = document.createElement( "div" );
    error.id = "login-error";
    error.style.display = "none";
    error.style.color = "red";

    box.appendChild( userLabel );
    box.appendChild( document.createElement( "br" ) );
    box.appendChild( passwordLabel );
    box.appendChild( document.createElement( "br" ) );
    box.appendChild( button );
    box.appendChild( error );

    return box;
  }

  function showLoginUI() {
    var loginBox = createLoginUI();
    document.getElementById( "swagger-ui" ).prepend( loginBox );
    document.getElementById( "login-button" ).addEventListener( "click", doLogin );
  }

  window.onload = () => {
    renderSwaggerUi();
    showLoginUI();
  };
{{% else }}
  window.onload = () => {
    renderSwaggerUi();
  };
{{% end }}
</script>
</body>
</html>
