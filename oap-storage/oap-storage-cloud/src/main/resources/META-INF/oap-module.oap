name = oap-storage-cloud

services {
  oap-cloud-configuration {
    implementation = oap.storage.cloud.FileSystemConfiguration
    parameters {
      configuration {
//        fs.s3.identity = access_key
//        fs.s3.credential = access_secret
//        fs.s3.endpoint = "http://localhost:1234"
//        fs.s3.headers = DEBUG

        fs.s3.container = test-bucket
        fs.default.scheme = s3
        fs.default.alias = my-alias
      }
    }
  }
}