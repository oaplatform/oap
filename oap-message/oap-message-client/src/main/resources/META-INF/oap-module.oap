name = oap-message-client
dependsOn = oap-http
services {
  oap-http-message-sender {
    implementation = oap.message.client.MessageSender
    parameters {
      timeout = 5s
      retryTimeout = 1s
      globalIoRetryTimeout = 1s
      diskSyncPeriod = 1m
      memorySyncPeriod = 100
      keepAliveDuration = 30d
      storageLockExpiration = 1h
      concurrency = 1
      maxMessages = 5000
      // disk spool ( <persistenceDirectory>/spool ) of the messages that cannot be delivered now, see README
      spool = false
      spoolMaxAge = 0
      spoolMaxSize = 0
      spoolMinFreeSpace = 0
      spoolSegmentSize = 67108864
      spoolSync = PERIODIC
      spoolSyncInterval = 1s
      spoolReplayMessages = 64
      port = 8081

      //      host = <unknown>
      httpPrefix = /messages

      //      persistenceDirectory = /opt/oap/messages/sender
    }
    supervision.supervise = true
  }
}
